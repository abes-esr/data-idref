             <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://purl.org/dc/terms/bibliographicCitation>" ;
             rdfs:label "a pour citation bibliographique"@fr .


###  https://sipaof.fr/expertes#hasPubType
:hasPubType rdf:type owl:ObjectProperty ;
