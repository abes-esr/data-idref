###  https://bdcmining.ouest-france.fr#genre
:genre rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#StringEqualsProperty> ;
       rdfs:domain :Personne ;
       rdfs:range :Gender ;
       <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://xmlns.com/foaf/0.1/gender>" ;
       rdfs:label "est du genre"@fr .


###  https://bdcmining.ouest-france.fr#hasLabel
:hasLabel rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#SearchProperty> ;
          rdfs:domain :Subject ;
          rdfs:range :Text ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://www.w3.org/2004/02/skos/core#prefLabel>" ;
          rdfs:label "a pour intitulé"@fr .


###  https://bdcmining.ouest-france.fr#hasName
:hasName rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#SearchProperty> ;
         rdfs:domain :Organization ,
                     :Personne ;
         rdfs:range :Text ;
         <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://www.w3.org/2004/02/skos/core#prefLabel>" ;
         rdfs:label "a pour nom"@fr .


###  https://bdcmining.ouest-france.fr#hasQualification
:hasQualification rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#SearchProperty> ;
                  rdfs:domain :Experte ,
                              :Personne ;
                  rdfs:range :Text ;
                  <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "^<http://id.loc.gov/vocabulary/relators/aut>/<http://purl.org/dc/terms/subject>/<http://www.w3.org/2004/02/skos/core#prefLabel>" ;
                  rdfs:label "a pour compétence"@fr .


###  https://bdcmining.ouest-france.fr#hasTitle
:hasTitle rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#SearchProperty> ;
