          rdfs:label "a pour titre"@fr .


###  https://bdcmining.ouest-france.fr#hassubject
:hassubject rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
            rdfs:domain :Document ;
            rdfs:range :Subject ;
            <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://purl.org/dc/terms/subject>"@fr ;
            rdfs:label "a pour sujet"@fr .


###  https://bdcmining.ouest-france.fr#isAuthor
:isAuthor rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#AutocompleteProperty> ;
          rdfs:domain :Personne ;
          rdfs:range :Document ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "^<http://id.loc.gov/vocabulary/relators/aut>"@fr ;
          rdfs:label "est auteur de"@fr .


###  https://bdcmining.ouest-france.fr#isLocated
:isLocated rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#SearchProperty> ;
           rdfs:domain :Experte ;
           rdfs:range :Text ;
           <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "^<http://id.loc.gov/vocabulary/relators/aut>/<http://id.loc.gov/vocabulary/relators/dgg>/<http://www.w3.org/2004/02/skos/core#prefLabel>"@fr ;
           rdfs:label "est localisée à"@fr .


###  https://bdcmining.ouest-france.fr#linkedTo
:linkedTo rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#AutocompleteProperty> ;
          rdfs:domain :Document ;
          rdfs:range :Organization ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://id.loc.gov/vocabulary/relators/dgg>"@fr ;
