      rdfs:range :pubType ;
      <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>" ;
      <http://data.sparna.fr/ontologies/sparnatural-config-datasources#datasource> <http://data.sparna.fr/ontologies/sparnatural-config-datasources#query_search_URI_contains> ;
